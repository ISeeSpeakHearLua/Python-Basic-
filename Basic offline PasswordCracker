import tkinter as tk
from tkinter import ttk
import itertools as it

root = tk.Tk()
root.configure(bg="Black")
root.title("PASSWORD CRACKER")
root.geometry("400x400")

chars = "abcdefghijklmnopqrstuvwxyz1234567890"

def Save():
    Password = Entry.get()
    count = 0
    for length in range(0,7):
        print("MOVING ONTO NEW SET OF DIGITS, ",length," DIGITS")
        for combo in it.product(chars, repeat=length):
            guess = "".join(combo)
            count += 1
            if count == 10000:
                print(guess)
                count = 0
            if Password == guess:
                print("CRACKED PASSWORD", guess)
                return
    
    


Label = tk.Label(text="ENTER PASSWORD",font="fixedsys",background="Black",foreground="Green")
Entry = tk.Entry(font="fixedsys",background="Black",foreground="Green")
button = tk.Button(font="fixedsys",background="Black",foreground="Green",text="START",command=Save)
Label.place(x=20, y=20, width=100, height=100)
Entry.place(x=20, y=70, width=100, height=100)
button.place(x=20, y=130, width=100, height=100)

Label.pack()
Entry.pack()
button.pack()
